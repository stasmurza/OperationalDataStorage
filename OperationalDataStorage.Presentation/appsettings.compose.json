{
  "DatabaseSettings": {
    "ConnectionString": "mongodb://host.docker.internal:27017",
    "DatabaseName": "Operational_data_storage",
    "HostName": "host.docker.internal",
    "Port": 27017
  },
  "RabbitMqClientSettings": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672,
    "ManagementPort": 15672
  },
  "EventsSnapshotSettings": {
    "ExchangeName": "events.snapshot",
    "QueueName": "events.snapshot.queue",
    "RoutingKeys": [ "operational.data.storage" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
